 func (h *Handler) buildWsURL(r *http.Request) string {
+	// When behind a reverse proxy (X-Forwarded-Proto set), don't include port
+	if r.Header.Get("X-Forwarded-Proto") != "" {
+		host := forwardedHostFirst(r)
+		if host == "" {
+			host = requestHostName(r)
+		}
+		return requestWSScheme(r) + "://" + host + "/pico/ws"
+	}
 	return requestWSScheme(r) + "://" + h.picoWebUIAddr(r) + "/pico/ws"
 }
